{
  "name": "shelfsense-v2",
  "version": "0.2.0",
  "description": "Reliable local ShelfSense IoT system for SIT314",
  "main": "src/demo.js",
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "demo": "node src/demo.js",
    "load-test": "node src/load-test.js",
    "evidence": "node src/evidence.js",
    "broker": "node src/broker.js",
    "api": "node src/api/server.js",
    "simulator": "node src/simulator.js",
    "inventory": "SERVICE_NAME=inventory node src/service-runner.js",
    "replenishment": "SERVICE_NAME=replenishment node src/service-runner.js",
    "cold-chain": "SERVICE_NAME=cold-chain node src/service-runner.js",
    "delivery": "SERVICE_NAME=delivery node src/service-runner.js",
    "dead-letter": "SERVICE_NAME=dead-letter node src/service-runner.js",
    "outbox": "node src/outbox-runner.js",
    "aws-worker": "node src/cloud/sqs-runner.js",
    "cloud-workload": "node src/cloud/workload.js",
    "security-check": "node scripts/security-check.js",
    "auth-token": "node src/auth-token.js",
    "node-red": "npx --yes node-red@4.0.9 --userDir node-red",
    "watch": "mqtt sub -t \"shelfsense/#\" -h localhost -v",
    "check-config": "node src/check-config.js && docker compose config --quiet",
    "check": "npm test && npm run demo && npm run load-test && npm run check-config",
    "check-ci": "npm test && npm run demo && npm run load-test && node src/check-config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Tommy Nguyen 224345482",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-sns": "3.1141.0",
    "@aws-sdk/client-sqs": "3.1141.0",
    "aedes": "^1.1.2",
    "mongoose": "^8.9.5",
    "mqtt": "^5.10.1"
  }
}
